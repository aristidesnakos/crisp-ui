{
  "name": "crisp-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Reusable dashboard patterns as a shadcn-compatible registry, plus the docs site that serves it.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristidesnakos/crisp-ui.git"
  },
  "scripts": {
    "dev": "pnpm --filter=v4 dev",
    "build": "pnpm --filter=v4 build",
    "start": "pnpm --filter=v4 start",
    "lint": "pnpm --filter=v4 lint",
    "typecheck": "pnpm --filter=v4 typecheck",
    "test": "pnpm --filter=v4 test",
    "format:check": "pnpm --filter=v4 format:check",
    "format:write": "pnpm --filter=v4 format:write",
    "registry:build": "pnpm --filter=v4 crisp:build"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^3.25 || ^4"
        }
      }
    }
  }
}
